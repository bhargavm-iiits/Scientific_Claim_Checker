# Python build products, environments and tool caches
__pycache__/
*.py[cod]
*.egg-info/
build/
dist/
.venv/
venv/
env/
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
.coverage.*
htmlcov/
.ipynb_checkpoints/

# Credentials and machine-local settings
.env
.env.*
!.env.example
.streamlit/secrets.toml
.aws/
.codex/
.agents/
*.pem
*.key
credentials.json
service-account*.json

# Downloaded datasets stay local. Keep population/source manifests and small
# project-authored examples needed to reproduce the general-science workflow.
data/*
!data/splits/
data/splits/*
!data/splits/*.json
!data/raw/
data/raw/*
!data/raw/source_manifest.json
!data/processed/
data/processed/*
!data/processed/data_quality.json
!data/examples/
data/examples/*
!data/examples/general_science_smoke_v1.jsonl
!data/examples/general_science_smoke_v1.metadata.json
!data/sources/
data/sources/*
!data/sources/usgs_water_verified_excerpt.json

# Generated artifacts stay local. Explicitly include compact reports and frozen
# protocols; exclude model weights, indexes, raw predictions, caches and backups.
artifacts/*
!artifacts/runs/
artifacts/runs/**
!artifacts/runs/**/
!artifacts/runs/**/report.md
!artifacts/runs/**/failure_analysis.md
!artifacts/runs/**/results.csv
!artifacts/runs/**/metrics.json
!artifacts/runs/**/confusion_matrices.json

!artifacts/retrieval/
artifacts/retrieval/*
!artifacts/retrieval/retrieval_eval_*.json
!artifacts/retrieval/retrieval_eval_*.csv

!artifacts/latency/
artifacts/latency/*
!artifacts/latency/*.json
!artifacts/latency/*.md

!artifacts/notebooks/
artifacts/notebooks/*
!artifacts/notebooks/course_lab_appendix_verification.json

!artifacts/improvement/
artifacts/improvement/**
!artifacts/improvement/**/
!artifacts/improvement/*_protocol_*.json
!artifacts/improvement/final_*_results.json
!artifacts/improvement/frozen_*.json
!artifacts/improvement/*_quality.json
!artifacts/improvement/metric_limits_*.json
!artifacts/improvement/*_completion_*.json
!artifacts/improvement/reach95_gap_audit*.json
!artifacts/improvement/**/metrics.json
!artifacts/improvement/**/paired_quality.json
!artifacts/improvement/**/failure_analysis.md
!artifacts/improvement/**/failure_cases.csv

# Defense in depth for downloaded/trained model binaries anywhere in the tree.
*.safetensors
*.pt
*.pth
*.ckpt
*.gguf
*.onnx
*.bin
hf_cache/
.cache/

# Temporary dependencies, local handoffs, logs and editor/OS files
tmp/
resume_*.md
*.log
*.tmp
*.part
*.bak
.DS_Store
Thumbs.db
.vscode/
.idea/
